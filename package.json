{
  "name": "quacklake",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --config wrangler.example.jsonc --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "smoke:ducklake": "bash scripts/test-ducklake-smoke.sh",
    "smoke:ducklake:r2": "bash scripts/test-ducklake-r2-smoke.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@polyglot-sql/sdk": "^0.13.0",
    "@quack-protocol/sdk": "^0.2.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/node": "^24",
    "@vitest/coverage-istanbul": "^5.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
